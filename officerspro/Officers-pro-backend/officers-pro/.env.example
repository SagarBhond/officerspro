# Local Docker database settings only.
DB_NAME=officerspro
DB_USERNAME=officerspro
DB_PASSWORD=localroot
MYSQL_ROOT_PASSWORD=localroot

# Required application secrets: use the real Keycloak client secret and a
# randomly generated AES key. Do not commit your populated .env file.
AES_ENCRYPTION_KEY=replace-with-a-random-32-byte-key
KEYCLOAK_CLIENT_SECRET=replace-with-the-keycloak-client-secret

# Public Keycloak realm. Configure the frontend client for your local callback
# URL when developing against this shared deployment.
KEYCLOAK_SERVER_URL=https://auth.sagarbhond.site/
KEYCLOAK_ISSUER_URI=https://auth.sagarbhond.site/realms/OfficerPro
KEYCLOAK_REALM=OfficerPro
KEYCLOAK_FRONTEND_CLIENT_ID=officerpro-officer-app
KEYCLOAK_BACKEND_CLIENT_ID=officerpro-admin

# The bucket must exist and the local AWS identity must have access to it.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=replace-with-your-s3-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

BACKEND_PORT=8082
FRONTEND_PORT=3004
